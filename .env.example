# KYC System Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/kyc_db

# JWT/Auth
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@kyc.com

# OAuth Configuration (Get these from OAuth providers)
# Google OAuth (https://console.developers.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (https://github.com/settings/applications/new)  
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# AWS S3 (Optional)
AWS_S3_BUCKET=kyc-documents-bucket
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# Admin Token
ADMIN_TOKEN=secure-admin-token-change-me
